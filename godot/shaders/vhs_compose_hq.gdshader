/* Композит буфера и VHS. Порт src/engine/vhs.js: все четырнадцать uniform'ов
   и весь фрагмент перенесены строка в строку, включая комментарии-объяснения.

   Сверх оригинала здесь две вещи, и обе — следствие устройства Godot:

   1. Склейка рук с миром. В браузере руки шли вторым RenderPass в тот же буфер,
      здесь это отдельный SubViewport с прозрачным фоном, поэтому источник —
      mix(world, hand.rgb, hand.a).
   2. Квантование 22 уровня с упорядоченным дизерингом Байера 4x4 из psx.js.
      В оригинале оно стояло последней строкой фрагмента КАЖДОГО материала,
      то есть по пикселям буфера и до всех эффектов ленты. В Godot дописать
      в цвет после light() нечего, поэтому квантование переехало сюда — на те же
      пиксели, в то же место цепочки. Отсюда же и его место внутри выборки:
      аберрация и снос цветности в оригинале читали уже квантованный буфер.

   Кассета идёт через этот же шейдер: tape_mode подменяет источник кадром плеера
   и режет пиллярбокс 4:3 — в оригинале это делал квад с ортокамерой, подставленный
   в мировой проход. Квантование на кассете выключено: её квад был MeshBasicMaterial,
   то есть мимо psxify.

   Идеи взяты из bad-tv-shader (Felix Turner, MIT). Shadertoy не трогаем: там CC BY-NC-SA. */

shader_type canvas_item;
render_mode unshaded;

// Источники. Все три — явные ViewportTexture из render_chain.gd: hint_screen_texture
// в canvas_item отдаёт экран окна, а нам нужны конкретные SubViewport'ы.
// filter_nearest — как NearestFilter у WebGLRenderTarget оригинала.
uniform sampler2D world_tex : filter_linear, repeat_disable;
uniform sampler2D hand_tex : filter_linear, repeat_disable;
uniform sampler2D tape_tex : filter_nearest, repeat_disable;
// Явный гейт композита рук. Остановленный HandView хранит последний кадр,
// поэтому одного UPDATE_DISABLED недостаточно: без этого множителя прежний
// фонарь остаётся поверх всех планов кат-сцены.
uniform float hand_mix = 0.0;

uniform vec2 resolution = vec2(640.0, 360.0);
uniform float time = 0.0;
uniform float aberration = 0.0022;  // расхождение каналов в долях ширины
uniform float scanline = 0.13;      // глубина скан-линий
uniform float grain = 0.075;        // зерно
uniform float vignette = 0.24;      // затемнение по краям
uniform float tracking = 0.0;       // 0..1, дрожание строчной синхронизации
uniform float warp = 0.055;         // бочка кинескопа
uniform float desaturate = 0.14;
uniform vec3 tint = vec3(1.03, 0.99, 0.94);
uniform float fade = 1.0;           // 0 = чёрный кадр, для затемнений между слоями

/* Ноль по умолчанию — обязательное условие: мир идёт через тот же проход,
   и оба эффекта не должны трогать его ни на пиксель, пока не идёт кассета. */
uniform float rain = 0.0;           // 0..1, плотность дождя в кадре
uniform float chroma_smear = 0.0;   // 0..1, снос цветности вправо шлейфом
uniform float head_switch = 0.0;    // 0..1, полоса перекоммутации головок внизу кадра

// Кассета: 1.0 — источник кадра плеера, tape_half — половина кадра 4:3 в долях буфера.
uniform float tape_mode = 0.0;
uniform vec2 tape_half = vec2(0.5, 0.5);

/* psx.js: SHARED.dither = 0.055, SHARED.levels = 22.

   Фаза 8. Размах дизера сведён к шагу квантования: 1/22 = 0.04545, а было 0.055 —
   на 21 % больше шага. Упорядоченный дизер обязан закрывать ровно ступеньку;
   когда он шире, соседние ячейки Байера перекрываются и плитка 4x4 читается
   жёстче самой ступеньки, которую она пришла прятать. */
uniform float psx_dither = 0.04545;
uniform float psx_levels = 22.0;

/* Гейт дизера и зерна по яркости. Оба слоя аддитивны и не масштабируются
   ни по чему: вместе это +-16.6 кода из 255 там, где сам сигнал в темноте —
   единицы кодов, отсюда и «рябит с фонарём». Гейт душит их втрое на чёрном
   и не трогает вовсе на свету.

   0.0 — ровно как в браузерном прототипе, откат одним числом. */
uniform float psx_dark_gate = 1.0;
// Единицы сохраняют прежние эффекты. Пресет меняет множители, а катсцены
// продолжают вести grain/tracking/rain теми же uniform.
uniform float effect_strength = 1.0;
uniform float grain_strength = 1.0;
uniform float quantization_strength = 1.0;
uniform float comb_strength = 1.0;

// Множитель шума по локальной яркости. 0.12 — верх «темноты»: выше него
// картинка уже читается, и зерно там на месте.
float dark_k(vec3 c) {
	float lum = dot(c, vec3(0.299, 0.587, 0.114));
	return mix(1.0, mix(0.35, 1.0, smoothstep(0.0, 0.12, lum)), psx_dark_gate);
}

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

/* Один слой дождя. Кадр делится на колонки, в части колонок висит короткая
   светлая черта, и вся сетка ползёт вниз с наклоном. Три таких слоя с разной
   частотой колонок и разной скоростью складываются в дождь; один читается
   решёткой, два — занавеской.

   Почему не партиклы. Их в проекте нет вовсе, а завести — значит платить
   за каждую каплю отрисовкой и уходом из буфера 982x540 в полное разрешение.
   Здесь дождь стоит несколько инструкций на пиксель ТОГО ЖЕ буфера. */
float rain_layer(vec2 uv, float t, float cols, float speed, float slant) {
	vec2 p = vec2(uv.x * cols + uv.y * slant, uv.y * 1.15 + t * speed);
	float id = floor(p.x);
	float h = hash(vec2(id, 17.0));
	// Струя далеко не в каждой колонке: при буфере 982 колонок под три сотни,
	// и заполнить хотя бы каждую пятую — это уже ливень.
	float on = step(0.84, h);
	float y = fract(p.y + h * 9.0);
	// Длинная тонкая черта с резким верхом: капля читается летящей вниз
	// только если она заметно длиннее своей ширины.
	float streak = pow(max(0.0, 1.0 - y * 2.6), 2.0);
	// Ядро в один-два пикселя и мягкий край: широкая струя — это уже снег.
	float x = abs(fract(p.x) - 0.5) * 2.0;
	return on * streak * (1.0 - smoothstep(0.05, 0.42, x));
}


// Bayer 4x4 без индексации массива: не все драйверы её любят в GLSL ES 1.00.
float psx_bayer(vec2 p) {
	vec2 a = mod(p, 2.0);
	vec2 b = floor(0.5 * mod(p, 4.0));
	float o1 = mix(mix(0.0, 2.0, a.x), mix(3.0, 1.0, a.x), a.y);
	float o2 = mix(mix(0.0, 2.0, b.x), mix(3.0, 1.0, b.x), b.y);
	return (4.0 * o1 + o2) / 16.0;
}

/* Одна выборка источника. Аргумент — в координатах оригинала (v растёт снизу вверх),
   разворот к координатам Godot делаем здесь и только здесь: так формулы ниже
   переносятся из vhs.js дословно. */
vec3 tap(vec2 guv) {
	vec2 t = vec2(guv.x, 1.0 - guv.y);

	if (tape_mode > 0.5) {
		// Пиллярбокс симметричен относительно центра, поэтому разворот v ему безразличен.
		vec2 f = (t - 0.5) / (2.0 * tape_half) + 0.5;
		if (f.x < 0.0 || f.x > 1.0 || f.y < 0.0 || f.y > 1.0) {
			return vec3(0.0);
		}
		return texture(tape_tex, f).rgb;
	}

	vec3 w = texture(world_tex, t).rgb;
	vec4 h = texture(hand_tex, t);
	vec3 col = mix(w, h.rgb, h.a * hand_mix);

	// FRAG_DITHER из psx.js. Координата — пиксель ИСТОЧНИКА: в оригинале дизер
	// считался в проходе мира, то есть по своему же пикселю, а не по пикселю
	// назначения. Буферы одного размера, поэтому guv * resolution — тот самый
	// gl_FragCoord.xy, дробная половина пикселя включительно.
	float t4 = psx_bayer(guv * resolution) - 0.5;
	vec3 c = col + t4 * psx_dither * dark_k(col);
	return mix(col, floor(c * psx_levels + 0.5) / psx_levels, quantization_strength);
}

void fragment() {
	vec2 uv = vec2(UV.x, 1.0 - UV.y);

	// Бочка кинескопа: слабая, иначе от неё быстро устаёшь.
	vec2 cc = uv - 0.5;
	float r2 = dot(cc, cc);
	uv = 0.5 + cc * (1.0 + warp * max(effect_strength, tape_mode) * r2);

	// Дрожание трекинга: горизонтальный сдвиг строк узкой полосой, которая ползёт вверх.
	if (tracking > 0.001) {
		float band = smoothstep(0.0, 0.08, abs(fract(uv.y * 0.6 - time * 0.22) - 0.5) * -1.0 + 0.5);
		float jitter = (hash(vec2(floor(uv.y * resolution.y), floor(time * 24.0))) - 0.5);
		uv.x += jitter * band * tracking * 0.035;
	}

	// За границей кадра — чернота, чтобы бочка не размазывала края.
	if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
		COLOR = vec4(0.0, 0.0, 0.0, 1.0);
	} else {
		// Хроматическая аберрация: к краям кадра сильнее, как у дешёвой оптики.
		float ab = aberration * max(effect_strength, tape_mode) * (0.35 + r2 * 2.4);
		vec3 col;
		col = tap(uv);
		if (abs(ab) > 0.00001) {
			col.r = tap(uv + vec2(ab, 0.0)).r;
			col.b = tap(uv - vec2(ab, 0.0)).b;
		}

		/* Снос цветности — подпись VHS, и она не имеет отношения к аберрации выше.
		   Цветность на ленте пишется отдельной поднесущей с полосой вчетверо уже
		   яркостной, поэтому она отстаёт от яркости и тянется ВПРАВО шлейфом,
		   а границы предметов остаются на месте. Отсюда и правка только R и B:
		   G несёт почти всю люму, сдвинуть его — значит сдвинуть картинку.
		   Берём цвет слева от пикселя (uv минус смещение) — тогда пятно
		   размазывается вправо, как на кассете. Три отсчёта: 0.45 %, 0.9 % и 1.6 %
		   ширины кадра, то есть при буфере 640 — примерно 3, 6 и 10 пикселей.
		   В долях ширины, а не в пикселях, чтобы шлейф не менял длину вместе
		   с размером окна: aberration выше меряется так же. */
		if (chroma_smear > 0.001) {
			vec3 s1 = tap(uv - vec2(0.0045, 0.0));
			vec3 s2 = tap(uv - vec2(0.0090, 0.0));
			vec3 s3 = tap(uv - vec2(0.0160, 0.0));
			// Веса в сумме единица: шлейф размазывает насыщенность, а не поднимает её.
			float trail_r = s1.r * 0.5 + s2.r * 0.3 + s3.r * 0.2;
			float trail_b = s1.b * 0.5 + s2.b * 0.3 + s3.b * 0.2;
			// 0.85 — потолок: при полной замене цвет отрывается от предмета совсем,
			// и кадр читается браком рендера, а не плёнкой.
			float k = clamp(chroma_smear, 0.0, 1.0) * 0.85;
			col.r = mix(col.r, trail_r, k);
			col.b = mix(col.b, trail_b, k);
		}

		/* Перекоммутация головок. В конце поля видеоголовка меняется, и последние
		   строки кадра уезжают вбок и шумят — на бытовом VHS это видно всегда,
		   если не обрезать overscan. Берём нижние 4 % высоты: при буфере 360
		   это 14 строк, из которых на половину силы и выше работают нижние семь —
		   smoothstep гасит полосу быстрее, чем линейный спад.
		   uv.y = 0 — низ кадра: v-координата текстуры растёт снизу вверх. */
		if (head_switch > 0.001) {
			float band = 1.0 - smoothstep(0.0, 0.04, uv.y);
			if (band > 0.002) {
				float k = clamp(head_switch, 0.0, 1.0);
				// Сдвиг гуляет от 0.2 % до 2.2 % ширины: он держится на натяжении
				// ленты, а оно не постоянно. 7.3 — частота той же качки, что у грубой
				// полосы на канве плеера; фаза разойдётся (часы у них разные),
				// и это к лучшему: две полосы в унисон читались бы одной.
				float shift = (0.012 + 0.010 * sin(time * 7.3)) * band * k;
				vec3 hcol = tap(vec2(clamp(uv.x + shift, 0.0, 1.0), uv.y));
				// Сигнала в момент перекоммутации нет, на его месте строчный шум.
				float hn = hash(vec2(floor(uv.y * resolution.y) + floor(uv.x * resolution.x * 0.5),
									 floor(time * 30.0)));
				hcol = mix(hcol, vec3(hn), 0.35 * band * k);
				col = mix(col, hcol, band * k);
			}
		}

		/* Дождь. Место в цепочке выбрано, а не досталось: он идёт ПОСЛЕ сноса
		   цветности и ДО скан-линий, поэтому строчная развёртка, гребёнка,
		   зерно и виньетка ложатся уже на него. Наклейка поверх готового кадра
		   читалась бы наклейкой; здесь дождь снят на ту же плёнку, что двор. */
		if (rain > 0.001) {
			float k = clamp(rain, 0.0, 1.0);
			// Третье число — наклон струи В КОЛОНКАХ на всю высоту кадра:
			// при 190 колонках 14 — это семь процентов ширины, то есть
			// ветер есть, но дождь не летит вбок.
			float drops = rain_layer(uv, time, 190.0, 1.25, 14.0)
				+ rain_layer(uv, time, 260.0, 1.75, 20.0) * 0.8
				+ rain_layer(uv, time, 145.0, 0.95, 10.0) * 0.55;
			// Струя не белая: на ночной плёнке она серо-голубая и полупрозрачная.
			col += vec3(0.30, 0.34, 0.38) * drops * k;
			// И общая мокрая муть поверх — то, чего одни струи не дают.
			col = mix(col, col * 0.94 + vec3(0.015, 0.017, 0.02), k * 0.5);
		}

		// Скан-линии считаем по физическим пикселям источника.
		float sl = sin(uv.y * resolution.y * 3.14159);
		col *= 1.0 - scanline * max(effect_strength, tape_mode) * (0.5 + 0.5 * sl);

		// Лёгкая гребёнка по горизонтали — след от компонентного сигнала.
		col *= 1.0 - 0.03 * max(comb_strength, tape_mode) * (0.5 + 0.5 * sin(uv.x * resolution.x * 3.14159));

		// Зерно. Тем же гейтом, что и дизер: в темноте это второй аддитивный
		// слой поверх первого, и вместе они и дают рябь.
		float n = hash(uv * resolution + fract(time) * 137.0);
		col += (n - 0.5) * mix(max(0.0, grain - 0.075), grain, max(grain_strength, tape_mode)) * dark_k(col);

		// Плёнка «садит» цвет и уводит его в тёплую охру.
		float lum = dot(col, vec3(0.299, 0.587, 0.114));
		col = mix(col, vec3(lum), desaturate * max(effect_strength, tape_mode));
		col *= mix(vec3(1.0), tint, max(effect_strength, tape_mode));

		// Виньетка.
		col *= 1.0 - vignette * smoothstep(0.18, 0.78, r2 * 2.0);

		COLOR = vec4(max(col, vec3(0.0)) * fade, 1.0);
	}
}
