/* Плёнка кассеты: всё, что в оригинале делалось по пикселям на канве.

   В src/ui/tape.js зерно накладывалось через getImageData/putImageData —
   76 800 пикселей на кадр в цикле по массиву. В GDScript такой цикл стоит
   больше, чем весь остальной кадр вместе взятый, поэтому попиксельная работа
   уехала сюда. Всё, что рисуется прямоугольниками и текстом (полосы wow,
   меню камкордера, царапины, выпадения, полоса трекинга), осталось в
   tape_draw.gd — там оно дешёвое.

   Один файл на два прохода: кассете по контракту положен один шейдер.
   Проходы не смешиваются, у каждого свой материал и свой набор uniform'ов:

     fx_pass = 0 — полосы кадра (tape_draw.gd, роль ROLE_STRIPS).
                   Только ночной режим камеры: composite-операция 'saturation'
                   с серым #808080 снимает цветность, оставляя люминанс
                   (Lum = 0.3R + 0.59G + 0.11B из спецификации смешивания).
                   Люминанс — линейная функция, поэтому обесцвечивать каждый
                   вызов отрисовки по отдельности и обесцветить готовый кадр —
                   одно и то же; меню и артефакты рисуются другим узлом
                   и цвет сохраняют, как в оригинале.

     fx_pass = 1 — плёнка поверх собранного кадра (зерно, строчки,
                   перекоммутация головок, виньетка). Источник — TEXTURE,
                   то есть готовый кадр 320x240 из BlitView.

   Порядок внутри второго прохода тот же, что в _artifacts()/_headSwitch():
   зерно, строчки, сдвиг нижних строк, виньетка последней. */

shader_type canvas_item;
render_mode unshaded;

// Какой из двух проходов рисует материал (см. шапку).
uniform float fx_pass = 0.0;

// Ночной режим камеры: tape.mono или shot.mono.
uniform float mono = 0.0;

uniform vec2 tape_size = vec2(320.0, 240.0);

// Меняется каждый кадр: зерно обязано быть новым, иначе оно читается сеткой.
uniform float seed = 0.0;

// 0.055 + static * 0.14 + fx * 0.42 — считает tape_player.gd.
uniform float noise_amount = 0.055;

// Сдвиг полосы перекоммутации головок, пиксели кадра 320x240.
uniform float head_shift = 3.0;
uniform float head_rows = 8.0;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

void fragment() {
	if (fx_pass < 0.5) {
		if (mono > 0.5) {
			COLOR.rgb = vec3(dot(COLOR.rgb, vec3(0.3, 0.59, 0.11)));
		}
	} else {
		vec2 px = UV * tape_size;
		vec2 uv = UV;

		/* Перекоммутация головок: нижние восемь строк сдвинуты вправо.
		   На канве это был drawImage самой в себя, здесь — сдвиг координаты
		   выборки. Левее сдвига источника нет: там остаётся то, что было,
		   и его закрашивает чернотой tape_draw.gd. */
		float top = tape_size.y - head_rows;
		if (px.y >= top && px.x >= head_shift) {
			uv.x = (px.x - head_shift) / tape_size.x;
		}
		vec3 col = texture(TEXTURE, uv).rgb;

		// Зерно: одно и то же число во все три канала — как d[i], d[i+1], d[i+2]
		// в оригинале. Цветного шума на чёрно-белой головке не бывает.
		float n = hash(px + vec2(seed, seed * 1.37));
		col += (n - 0.5) * noise_amount;

		// Строчки: каждая третья строка кадра темнее на 0.22.
		if (mod(floor(px.y), 3.0) < 0.5) {
			col *= 1.0 - 0.22;
		}

		// Виньетка кинескопа: радиальный градиент от H*0.28 (прозрачный)
		// до H*0.86 (чёрный 0.72).
		float d = distance(px, tape_size * 0.5);
		float r0 = tape_size.y * 0.28;
		float r1 = tape_size.y * 0.86;
		float v = clamp((d - r0) / (r1 - r0), 0.0, 1.0);
		col *= 1.0 - 0.72 * v;

		COLOR = vec4(clamp(col, vec3(0.0), vec3(1.0)), 1.0);
	}
}
